      "panel-1": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "ag1xirw6vj9xcc"
                      },
                      "group": "influxdb",
                      "kind": "DataQuery",
                      "spec": {
                        "query": "from(bucket: \"sensores_agricolas\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) => r[\"_measurement\"] == \"sensores\")\r\n  |> filter(fn: (r) => r[\"node\"] == \"npk-01\")\r\n  |> filter(fn: (r) =>\r\n      r[\"_field\"] == \"nitrogen\" or\r\n      r[\"_field\"] == \"phosphorus\" or\r\n      r[\"_field\"] == \"potassium\"\r\n  )\r\n  |> map(fn: (r) => ({\r\n      r with\r\n      _field:\r\n        if r._field == \"nitrogen\" then \"Nitrógeno\"\r\n        else if r._field == \"phosphorus\" then \"Fósforo\"\r\n        else if r._field == \"potassium\" then \"Potasio\"\r\n        else r._field\r\n  }))\r\n  |> drop(columns: [\"device_id\", \"node\", \"sensor_type\"])"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "",
