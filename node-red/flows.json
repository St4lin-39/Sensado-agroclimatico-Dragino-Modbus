    {
        "id": "846ddcbf2ba219b4",
        "type": "function",
        "z": "7d33ad7101fe824e",
        "name": "limpiar clima ",
        "func": "\nconst INVALIDO = -999;\nconst limpio = {};\nconst descartados = [];\n\nfor (const [campo, valor] of Object.entries(msg.payload)) {\n    if (valor === INVALIDO) {\n        descartados.push(campo);\n    } else {\n        limpio[campo] = valor;\n    }\n}\n\nif (descartados.length > 0) {\n    node.warn(`Descartados en ${msg.payload.device_id}: ${descartados.join(\", \")}`);\n}\n\nmsg.payload = limpio;\nreturn msg;",
